# Required
GROQ_API_KEY=your_original_grok_API_Key         # free key: https://console.groq.com/keys

# Optional — model
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — security (unset = open, fine for local dev / grading; set both before real prod use)
WIDGET_API_KEY=                              # if set, /chat requires header x-api-key: <this>
ADMIN_KEY=                                   # required for /admin/* endpoints (tickets, RMAs, credits)

# Optional — CORS (comma-separated origins; "*" = allow all, fine for local dev only)
ALLOWED_ORIGINS=*

# Optional — rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Optional — set to "keyword" to skip the ~700MB sentence-transformers/torch download
# and use a lightweight keyword-overlap fallback for policy search instead. Lower
# retrieval quality but much smaller/faster to deploy on constrained free tiers.
POLICY_SEARCH_MODE=semantic

# Optional — SQLite file location (defaults to ./data_store.sqlite3)
TRENDLY_DB_PATH=
